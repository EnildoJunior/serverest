# Dependências
node_modules/

# Configuração local do Cypress.
# Nunca versionado: é o arquivo destinado a credenciais e a ajustes de ambiente.
cypress.env.json

# Artefatos gerados pela execução dos testes
cypress/screenshots/
cypress/videos/
cypress/downloads/

# Relatórios Allure.
# Ficam de fora do versionamento também por segurança: os resultados registram
# corpo de requisição e resposta, o que inclui tokens de autenticação emitidos
# durante a execução.
allure-results/
allure-report/

# Ferramentas locais
.claude/
