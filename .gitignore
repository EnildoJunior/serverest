# Dependências
node_modules/

# Configuração local do Cypress.
# Nunca versionado: é o arquivo destinado a credenciais e a ajustes de ambiente.
cypress.env.json

# Evidências e artefatos gerados pela execução dos testes
cypress/screenshots/
cypress/videos/
cypress/downloads/

# Relatórios (mochawesome e Allure).
# Ficam de fora do versionamento também por segurança: os resultados registram
# corpo de requisição e resposta, o que inclui tokens emitidos na execução.
cypress/reports/
mochawesome-report/
allure-results/
allure-report/

# Ferramentas locais
.claude/
