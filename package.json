{
  "name": "desafio-automacao-serverest",
  "version": "1.0.0",
  "description": "Suite de testes automatizados E2E e de API para a plataforma ServeRest",
  "private": true,
  "scripts": {
    "cy:open": "node scripts/cypress.js open",
    "cy:run": "node scripts/cypress.js run",
    "clean:reports": "node -e \"require('fs').rmSync('cypress/reports',{recursive:true,force:true})\"",
    "verificar:bdd": "node scripts/verificar-rastreabilidade.js",
    "pretest": "npm run clean:reports",
    "test": "node scripts/cypress.js run"
  },
  "devDependencies": {
    "cypress": "^15.21.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "mochawesome": "^8.1.1"
  }
}
